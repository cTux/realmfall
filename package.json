{
  "name": "realmfall",
  "private": true,
  "version": "0.3.268",
  "description": "Single-player browser survival RPG with hex exploration, turn-based systems, React UI, and Pixi.js world rendering.",
  "keywords": [
    "browser-game",
    "survival-rpg",
    "hex-crawl",
    "turn-based",
    "roguelite",
    "pixi.js",
    "react",
    "vite"
  ],
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "repository": {
    "type": "git",
    "url": "git@github.com:cTux/realmfall.git"
  },
  "homepage": "https://github.com/cTux/realmfall",
  "bugs": {
    "url": "https://github.com/cTux/realmfall/issues"
  },
  "engines": {
    "node": "25.x",
    "pnpm": "11.x"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "node ./scripts/run-dev.mjs",
    "dev:storybook": "turbo dev:storybook",
    "dev:ui:storybook": "pnpm --filter @realmfall/ui-react dev:storybook",
    "dev:client": "pnpm --filter @realmfall/client-web dev",
    "dev:client:storybook": "pnpm --filter @realmfall/client-web dev:storybook",
    "dev:server-chat": "pnpm --filter @realmfall/server-chat dev",
    "dev:server-world": "pnpm --filter @realmfall/server-world dev",
    "serve": "node ./scripts/run-serve.mjs",
    "serve:client": "pnpm --filter @realmfall/client-web serve",
    "serve:server-chat": "pnpm --filter @realmfall/server-chat serve",
    "serve:server-world": "pnpm --filter @realmfall/server-world serve",
    "build": "turbo build",
    "build:common": "pnpm --filter @realmfall/common build",
    "build:core": "pnpm --filter @realmfall/core build",
    "build:ui": "pnpm --filter @realmfall/ui-react build",
    "build:ui:storybook": "pnpm --filter @realmfall/ui-react build:storybook",
    "build:client": "pnpm --filter @realmfall/client-web build",
    "build:client:assets": "pnpm --filter @realmfall/client-web build:client:assets",
    "build:client:storybook": "pnpm --filter @realmfall/client-web build:storybook",
    "build:server-chat": "pnpm --filter @realmfall/server-chat build",
    "build:server-world": "pnpm --filter @realmfall/server-world build",
    "typecheck": "turbo typecheck",
    "typecheck:common": "pnpm --filter @realmfall/common typecheck",
    "typecheck:core": "pnpm --filter @realmfall/core typecheck",
    "typecheck:ui": "pnpm --filter @realmfall/ui-react typecheck",
    "typecheck:client": "pnpm --filter @realmfall/client-web typecheck",
    "typecheck:server-chat": "pnpm --filter @realmfall/server-chat typecheck",
    "typecheck:server-world": "pnpm --filter @realmfall/server-world typecheck",
    "lint": "turbo lint",
    "lint:common": "pnpm --filter @realmfall/common lint",
    "lint:core": "pnpm --filter @realmfall/core lint",
    "lint:ui": "pnpm --filter @realmfall/ui-react lint",
    "lint:client": "pnpm --filter @realmfall/client-web lint",
    "lint:server-chat": "pnpm --filter @realmfall/server-chat lint",
    "lint:server-world": "pnpm --filter @realmfall/server-world lint",
    "lint:fix": "turbo lint:fix",
    "lint:common:fix": "pnpm --filter @realmfall/common lint:fix",
    "lint:ui:fix": "pnpm --filter @realmfall/ui-react lint:fix",
    "lint:client:fix": "pnpm --filter @realmfall/client-web lint:fix",
    "lint:server-chat:fix": "pnpm --filter @realmfall/server-chat lint:fix",
    "lint:server-world:fix": "pnpm --filter @realmfall/server-world lint:fix",
    "test": "turbo test",
    "test:common": "pnpm --filter @realmfall/common test",
    "test:core": "pnpm --filter @realmfall/core test",
    "test:ui": "pnpm --filter @realmfall/ui-react test",
    "test:client": "pnpm --filter @realmfall/client-web test",
    "test:server-chat": "pnpm --filter @realmfall/server-chat test",
    "test:server-world": "pnpm --filter @realmfall/server-world test",
    "deps:update": ":",
    "auto:version:bump": "node scripts/commit-version-bump.mjs",
    "auto:pre:commit": "node scripts/run-staged-quality.mjs",
    "auto:pre:push": "node scripts/run-pre-push-quality.mjs",
    "git:deploy": "node scripts/git-deploy.mjs",
    "git:prune": "node scripts/prune-gone-branches.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "husky": "^9.1.7",
    "turbo": "^2.9.12"
  }
}
