{
  "name": "@realmfall/ui-react",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./generatedIconPools": "./src/generatedIconPools.ts",
    "./i18n": "./src/i18n/index.ts",
    "./i18n/bootstrap": "./src/i18n/bootstrap.ts",
    "./loading-spinner": "./src/components/LoadingSpinner/LoadingSpinner.tsx"
  },
  "scripts": {
    "dev:storybook": "storybook dev -p 6008 --config-dir ./.storybook",
    "build": "tsc -p ./tsconfig.build.json && vite build --config ./vite.config.ts",
    "build:storybook": "storybook build --config-dir ./.storybook",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "lint": "pnpm lint:oxlint && pnpm lint:css",
    "lint:oxlint": "oxlint -c ../../.oxlintrc.json src ./.storybook ./vite.config.ts",
    "lint:css": "stylelint \"src/**/*.{css,scss}\"",
    "test": "pnpm test:jsdom",
    "test:jsdom": "vitest run --environment jsdom --globals"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@storybook/react-vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "catalog:",
    "oxlint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sass": "catalog:",
    "storybook": "catalog:",
    "stylelint": "catalog:",
    "stylelint-config-standard": "catalog:",
    "stylelint-config-standard-scss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
