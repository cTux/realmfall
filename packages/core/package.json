{
  "name": "@realmfall/core",
  "version": "1.0.0",
  "description": "Canonical gameplay simulation and shared world model for Realmfall.",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "scripts": {
    "build": "tsc -p ./tsconfig.build.json",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "lint": "oxlint -c ../../.oxlintrc.json src",
    "test": "vitest run"
  },
  "exports": {
    ".": "./src/index.ts",
    "./core.config": "./src/core.config.ts",
    "./game": "./src/game/index.ts",
    "./game/content/abilities": "./src/game/content/abilities/index.ts",
    "./game/content/enemies": "./src/game/content/enemies/index.ts",
    "./game/content/items": "./src/game/content/items/index.ts",
    "./game/content/items/expansion": "./src/game/content/items/expansion/index.ts",
    "./game/content/items/meals": "./src/game/content/items/meals/index.ts",
    "./game/content/items/produce": "./src/game/content/items/produce/index.ts",
    "./game/content/structures": "./src/game/content/structures/index.ts",
    "./game/*": "./src/game/*.ts",
    "./i18n": "./src/i18n/index.ts",
    "./core/*": "./src/core/*",
    "./i18n/*": "./src/i18n/*"
  },
  "dependencies": {
    "@realmfall/common": "workspace:*",
    "valibot": "^1.4.0"
  },
  "devDependencies": {
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
