{
  "name": "@realmfall/client-web",
  "version": "1.0.0",
  "description": "Browser client app, Pixi renderer, and React UI shell for Realmfall.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config ./vite.config.ts",
    "dev:storybook": "storybook dev -p 6006 --config-dir ./.storybook",
    "build": "node ./scripts/run-vite-build.mjs",
    "build:storybook": "storybook build --config-dir ./.storybook",
    "build:client:assets": "node ./scripts/build-world-terrain-atlas.mjs",
    "serve": "node ./scripts/serve-https.mjs",
    "typecheck": "tsc -p ./tsconfig.json --noEmit && tsc -p ./tsconfig.node.json --noEmit",
    "lint": "concurrently --names \"oxlint,css\" --prefix name \"pnpm lint:oxlint\" \"pnpm lint:css\"",
    "lint:oxlint": "oxlint -c ../../.oxlintrc.json src ./.storybook ./scripts ./vite.config.ts",
    "lint:css": "stylelint \"src/**/*.{css,scss}\"",
    "lint:fix": "oxlint -c ../../.oxlintrc.json --fix src ./.storybook ./scripts ./vite.config.ts",
    "test": "concurrently --names \"jsdom,node\" --prefix name \"pnpm test:jsdom\" \"pnpm test:node\"",
    "test:jsdom": "vitest run --project jsdom",
    "test:node": "vitest run --project node"
  },
  "dependencies": {
    "@realmfall/common": "workspace:*",
    "@realmfall/core": "workspace:*",
    "@realmfall/ui-react": "workspace:*",
    "@rexa-developer/tiks": "^0.1.9",
    "@tanstack/react-virtual": "^3.13.24",
    "comlink": "^4.4.2",
    "easy-cancelable-promise": "^2.0.1",
    "easy-web-worker": "^7.0.5",
    "howler": "^2.2.4",
    "pixi.js": "^8.18.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "valibot": "^1.4.0"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "0.2.3",
    "@storybook/react-vite": "catalog:",
    "@types/node": "catalog:",
    "@types/howler": "^2.2.12",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^9.2.1",
    "fast-check": "^4.7.0",
    "fuite": "^5.0.9",
    "globals": "^17.6.0",
    "jsdom": "catalog:",
    "npm-check-updates": "^22.1.0",
    "oxlint": "catalog:",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "catalog:",
    "selfsigned": "^5.5.0",
    "serve": "^14.2.6",
    "sharp": "^0.34.5",
    "storybook": "catalog:",
    "stylelint": "catalog:",
    "stylelint-config-standard": "catalog:",
    "stylelint-config-standard-scss": "catalog:",
    "svgo": "^4.0.2",
    "typescript": "catalog:",
    "unplugin-detect-duplicated-deps": "^2.0.0",
    "vite": "catalog:",
    "vite-plugin-minipic": "^1.3.2",
    "vitest": "catalog:"
  }
}
