{
  "name": "@realmfall/server-chat",
  "version": "1.0.0",
  "description": "Realmfall chat history and websocket notification service.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "build": "tsc -p ./tsconfig.build.json",
    "serve": "node ./scripts/serve-https.mjs",
    "start": "node ./dist/index.js",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "lint": "oxlint -c ../../.oxlintrc.json src vitest.config.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@realmfall/server-auth": "workspace:*",
    "fastify": "^5.8.5",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/ws": "^8.18.1",
    "oxlint": "catalog:",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
