{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "dev": {
      "persistent": true,
      "cache": false,
      "dependsOn": ["^dev:client", "^dev:server-world"]
    },
    "dev:client": {},
    "dev:server-world": {},

    "dev:storybook": {
      "persistent": true,
      "cache": false,
      "dependsOn": ["^dev:ui:storybook", "^dev:client:storybook"]
    },
    "dev:ui:storybook": {},
    "dev:client:storybook": {},

    "serve": {
      "dependsOn": ["^serve:client", "^serve:server-world"]
    },
    "serve:client": {
      "dependsOn": ["^build:client"],
      "outputs": ["dist"]
    },
    "serve:server-world": {
      "dependsOn": ["^build:server-world"],
      "outputs": ["dist"]
    },

    "build": {
      "env": ["REALMFALL_VITE_BASE"],
      "dependsOn": [
        "^build:common",
        "^build:ui",
        "^build:ui:storybook",
        "^build:client",
        "^build:client:storybook",
        "^build:server-world"
      ]
    },
    "build:common": {
      "outputs": ["dist"]
    },
    "build:ui": {
      "outputs": ["dist"]
    },
    "build:ui:storybook": {
      "outputs": ["dist"]
    },
    "build:client": {
      "dependsOn": ["^build:common", "^build:ui", "^build:client:assets"],
      "outputs": ["dist"]
    },
    "build:client:storybook": {
      "dependsOn": ["^build:common", "^build:ui"],
      "outputs": ["dist"]
    },
    "build:client:assets": {
      "outputs": ["src/assets/generated"]
    },
    "build:server-world": {
      "dependsOn": ["^build:common"],
      "outputs": ["dist"]
    },

    "typecheck": {
      "dependsOn": [
        "^typecheck:common",
        "^typecheck:ui",
        "^typecheck:client",
        "^typecheck:server-world"
      ]
    },
    "typecheck:common": {},
    "typecheck:ui": {},
    "typecheck:client": {},
    "typecheck:server-world": {},

    "lint": {
      "dependsOn": [
        "^lint:common",
        "^lint:ui",
        "^lint:client",
        "^lint:server-world"
      ]
    },
    "lint:common": {},
    "lint:ui": {},
    "lint:client": {},
    "lint:server-world": {},

    "test": {
      "dependsOn": [
        "^test:common",
        "^test:ui",
        "^test:client",
        "^test:server-world"
      ]
    },
    "test:common": {},
    "test:ui": {},
    "test:client": {},
    "test:server-world": {}
  }
}
